# Spotify app credentials — fill these in after registering at
# https://developer.spotify.com/dashboard
#
# Stub mode (no credentials needed): leave CLIENT_ID blank, run with
#   SPOTIPY_CLIENT_ID= python app.py
# It will use fake data and render "STUB MODE" in the UI.
#
# Live mode: paste your real Client ID and Client Secret.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Must match exactly what you entered in the Spotify app's Redirect URIs.
# Loopback addresses only — Spotify rejects "localhost".
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8000/callback

# Cache TTL for raw Spotify pulls (hours). Defaults to 24.
CACHE_TTL_HOURS=24
